# EditorConfig for C# code style enforcement
# Docs: https://learn.microsoft.com/en-us/visualstudio/ide/editorconfig-code-style-settings-reference

root = true

# All files
[*]
charset = utf-8
trim_trailing_whitespace = true

# C# files
[*.cs]
# Core formatting
indent_size = 4
indent_style = space
end_of_line = crlf
insert_final_newline = true

# var preferences
csharp_style_var_for_built_in_types = false
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false

# Braces
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = all

# New lines
csharp_new_line_before_catch = true
csharp_new_line_before_else = true
csharp_new_line_before_finally = true

# Indentation
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# Using directives
csharp_using_directive_placement = outside_namespace:suggestion

# Expression-level preferences
csharp_style_expression_bodied_methods = false
csharp_style_expression_bodied_properties = true

# Naming conventions - Interfaces begin with I
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = suggestion
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interface
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = begins_with_i

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = *

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# Public members should be PascalCase
dotnet_naming_rule.public_members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.public_members_should_be_pascal_case.symbols = public_symbols
dotnet_naming_rule.public_members_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.public_symbols.applicable_kinds = property, method, field, event, delegate
dotnet_naming_symbols.public_symbols.applicable_accessibilities = public

dotnet_naming_style.pascal_case.capitalization = pascal_case
